# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/

# production
/build
build/

# misc
.DS_Store
Thumbs.db
*.pem

# IDE
.vscode/
.idea/

# Agent / IDE tooling
.claude/

# Python (in case any scripts/tooling are ever run from repo root)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
*.egg-info/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backup / scratch files (not needed in repo)
past_dark_theme_page.tsx
past_themes.patch

# Context / reference images
context/

# Temporary screenshot dumps used during development
reference/*.png
