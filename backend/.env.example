# Copy this file to .env and fill in your actual keys
GEMINI_API_KEY=your_google_ai_studio_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Only required for the background task scheduler (core/scheduler.py) to poll
# due tasks across all users; leave unset to disable it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Only required for the server-side Google token-refresh fallback
# (mcp_integration/mcp_manager.py); leave unset to disable it. Must match
# the OAuth client configured in Supabase's Google provider settings.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Gmail MCP connector (mcp_integration/gmail_mcp.py) -- a separate OAuth
# client from GOOGLE_CLIENT_ID/SECRET above, dedicated to Google's managed
# Gmail MCP server. Leave unset to disable /api/connectors/gmail-mcp/authorize.
GMAIL_MCP_CLIENT_ID=your_gmail_mcp_oauth_client_id_here
GMAIL_MCP_CLIENT_SECRET=your_gmail_mcp_oauth_client_secret_here
GMAIL_MCP_REDIRECT_URI=http://localhost:8000/api/connectors/gmail-mcp/callback
# LOCAL DEV ONLY -- lets /api/connectors/gmail-mcp/authorize accept an
# unverified ?dev_user_id=... in place of a real Supabase access_token, to
# test the Google consent/redirect/callback flow straight from a browser.
# Leave unset (or false) everywhere else -- never set this in a deployed
# environment.
GMAIL_MCP_DEV_MODE=false
# Canvas Drive connector (canvas/drive_oauth.py) -- a separate OAuth client
# from GOOGLE_CLIENT_ID/SECRET and GMAIL_MCP_CLIENT_ID/SECRET above,
# requesting the restrictive drive.file scope. Leave unset to disable
# /api/canvas/drive/authorize.
CANVAS_DRIVE_CLIENT_ID=your_canvas_drive_oauth_client_id_here
CANVAS_DRIVE_CLIENT_SECRET=your_canvas_drive_oauth_client_secret_here
CANVAS_DRIVE_REDIRECT_URI=http://localhost:8000/api/canvas/drive/callback
# LOCAL DEV ONLY -- lets /api/canvas/drive/authorize accept an unverified
# ?dev_user_id=... in place of a real Supabase access_token. Leave unset (or
# false) everywhere else -- never set this in a deployed environment.
CANVAS_DRIVE_DEV_MODE=false
