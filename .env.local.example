# Copy this file to .env.local and fill in your actual values.

# Supabase project URL, read by src/utils/supabase/client.ts, server.ts, and middleware.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon/public key, read by the same client/server/middleware trio above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Leave unset for local development so next.config.ts falls back to
# http://127.0.0.1:8000; set it to the Render URL in Vercel's Production
# environment only. Rewrites resolve at build time, so a missing value in
# production silently proxies to a localhost that does not exist there, and
# the build still succeeds.
NEXT_PUBLIC_BACKEND_URL=
# LiveKit server URL for the voice feature, read by src/components/VoiceModal.tsx; voice throws if unset.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
